require "test_helper"

class <%= class_name %>CommandTest < ActiveSupport::TestCase
  test "to_definition returns valid command shape" do
    defn = <%= class_name %>Command.to_definition
    assert_equal "<%= file_name %>", defn[:name]
    assert defn[:trigger].present?
    assert_includes %i[stream json], defn[:response_type]
  end

  test "call raises NotImplementedError until implemented" do
    assert_raises(NotImplementedError) { <%= class_name %>Command.new.call }
  end
end
