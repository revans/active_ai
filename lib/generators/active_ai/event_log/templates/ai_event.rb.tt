# One ActiveAI event: a prompt sent (agent_request), an answer (agent_turn), a tool call,
# a query, a workflow step. Every event of a run shares its run_id; a provider call's
# request and answer share a span_id.
#
#   <%= event_class %>.for_run(agent.run_id)
#   <%= event_class %>.for_request(request.request_id)
class <%= event_class %> < <%= record_class %>
  include ActiveAI::EventLog

  self.table_name = "active_ai_events"

  # Payloads hold full prompts and answers; drop or redact what must not be stored here.
  #
  # A tool_call row keeps the tool and the arguments it was called with, but not its
  # result: the result goes back to the model, so the next agent_request already holds it.
  def self.filter_payload(name, payload)
    name == "tool_call.active_ai" ? payload.except(:result) : payload
  end
end
