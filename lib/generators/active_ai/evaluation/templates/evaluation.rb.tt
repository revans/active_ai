# Side-by-side evaluation of AI providers on your own scenarios (see evaluation/cases.yml).
# Generated by `rails generate active_ai:evaluation`; it is yours to change.
#
#   bin/rails ai:compare              # plan only: nothing is sent
#   RUN=1 bin/rails ai:compare        # real calls; costs money
module Evaluation
  PROVIDERS = %w[openai anthropic].freeze
end
